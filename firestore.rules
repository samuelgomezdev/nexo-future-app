rules_version = '2';

// Regras de segurança do Nexo Future (LGPD): cada pessoa acessa só os próprios dados.
// Testes: testes_regras/regras.test.mjs (rodam no emulador do Firebase).
service cloud.firestore {
  match /databases/{database}/documents {

    function eDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // O perfil tem só os campos do cadastro: nada de CPF, senha ou outros dados.
    function perfilJovemValido() {
      let dados = request.resource.data;
      return dados.keys().hasOnly([
          'nome', 'email', 'cidade', 'dataNascimento',
          'autorizacaoResponsavel', 'aceitePoliticaEm', 'criadoEm'])
        && dados.keys().hasAll([
          'nome', 'email', 'cidade', 'dataNascimento',
          'autorizacaoResponsavel', 'aceitePoliticaEm'])
        && dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 120
        && dados.email == request.auth.token.email
        && dados.cidade is string
        && dados.dataNascimento is timestamp
        && dados.autorizacaoResponsavel is bool
        && dados.aceitePoliticaEm is timestamp;
    }

    match /jovens/{uid} {
      allow read, delete: if eDono(uid);
      allow create, update: if eDono(uid) && perfilJovemValido();
    }

    function perfilEmpresaValido() {
      let dados = request.resource.data;
      return dados.keys().hasOnly([
          'nome', 'cnpj', 'setor', 'recrutador', 'email', 'cidade',
          'aceitePoliticaEm', 'criadoEm'])
        && dados.keys().hasAll([
          'nome', 'cnpj', 'setor', 'recrutador', 'email', 'cidade',
          'aceitePoliticaEm'])
        && dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 120
        && dados.cnpj is string && dados.cnpj.matches('[0-9]{14}')
        && dados.setor is string && dados.setor.size() > 0
        && dados.recrutador is string && dados.recrutador.size() > 0
        && dados.recrutador.size() <= 120
        && dados.email == request.auth.token.email
        && dados.cidade is string
        && dados.aceitePoliticaEm is timestamp;
    }

    match /empresas/{uid} {
      allow read, delete: if eDono(uid);
      allow create, update: if eDono(uid) && perfilEmpresaValido();
    }

    // O alvará é opcional no cadastro, mas vem completo: número e validade (RN0003).
    function perfilOficinaValido() {
      let dados = request.resource.data;
      let temNumero = 'alvaraNumero' in dados;
      let temValidade = 'alvaraValidade' in dados;
      return dados.keys().hasOnly([
          'nome', 'cnpj', 'gestor', 'email', 'cidade',
          'alvaraNumero', 'alvaraValidade', 'aceitePoliticaEm', 'criadoEm'])
        && dados.keys().hasAll([
          'nome', 'cnpj', 'gestor', 'email', 'cidade', 'aceitePoliticaEm'])
        && dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 120
        && dados.cnpj is string && dados.cnpj.matches('[0-9]{14}')
        && dados.gestor is string && dados.gestor.size() > 0 && dados.gestor.size() <= 120
        && dados.email == request.auth.token.email
        && dados.cidade is string
        && temNumero == temValidade
        && (!temNumero || (dados.alvaraNumero is string
          && dados.alvaraNumero.size() > 0 && dados.alvaraNumero.size() <= 60
          && dados.alvaraValidade is timestamp))
        && dados.aceitePoliticaEm is timestamp;
    }

    match /oficinas/{uid} {
      allow read, delete: if eDono(uid);
      allow create, update: if eDono(uid) && perfilOficinaValido();
    }

    // RN0001: publicar vaga ou curso, ou decidir um curso, só com o e-mail confirmado.
    function contaConfirmada() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function textoEntre(valor, minimo, maximo) {
      return valor is string && valor.size() >= minimo && valor.size() <= maximo;
    }

    function inteiroEntre(valor, minimo, maximo) {
      return valor is int && valor >= minimo && valor <= maximo;
    }

    // A vaga não guarda dados pessoais: o visitante pode lê-la (RN0007).
    function vagaValida() {
      let dados = request.resource.data;
      return dados.keys().hasOnly([
          'titulo', 'empresa', 'empresaId', 'area', 'cidade', 'qualificacao',
          'posicoes', 'situacao', 'cursos', 'criadoEm'])
        && dados.keys().hasAll([
          'titulo', 'empresa', 'empresaId', 'area', 'cidade', 'qualificacao',
          'posicoes', 'situacao', 'cursos', 'criadoEm'])
        && textoEntre(dados.titulo, 1, 80)
        && textoEntre(dados.empresa, 1, 120)
        && dados.area in ['Alimentos', 'Construção Civil', 'Logística',
          'Metalurgia', 'Naval', 'Turismo e Hotelaria']
        && dados.cidade in ['Balneário Camboriú', 'Balneário Piçarras',
          'Bombinhas', 'Camboriú', 'Ilhota', 'Itajaí', 'Itapema', 'Luiz Alves',
          'Navegantes', 'Penha', 'Porto Belo']
        && textoEntre(dados.qualificacao, 1, 500)
        && inteiroEntre(dados.posicoes, 1, 100)
        && dados.situacao in ['aberta', 'aguardandoIngresso', 'lotada']
        && dados.cursos is list
        // RN0006: no máximo 5 cursos por vaga.
        && dados.cursos.size() <= 5
        // RF0007: só aceita candidaturas com pelo menos um curso aprovado.
        && (dados.situacao != 'aguardandoIngresso' || dados.cursos.size() > 0)
        && dados.criadoEm is timestamp;
    }

    match /vagas/{vagaId} {
      allow read: if true;
      // RF0004: a vaga nasce aberta, sem cursos, pela empresa dona.
      allow create: if contaConfirmada()
        && exists(/databases/$(database)/documents/empresas/$(request.auth.uid))
        && request.resource.data.empresaId == request.auth.uid
        && vagaValida()
        && request.resource.data.situacao == 'aberta'
        && request.resource.data.cursos.size() == 0
        && request.resource.data.criadoEm == request.time;
      allow update: if contaConfirmada()
        && resource.data.empresaId == request.auth.uid
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.criadoEm == resource.data.criadoEm
        && vagaValida();
      allow delete: if contaConfirmada() && resource.data.empresaId == request.auth.uid;
    }

    function cursoValido() {
      let dados = request.resource.data;
      return dados.keys().hasOnly([
          'nome', 'area', 'cargaHoraria', 'vagasTurma', 'descricao', 'vagaId',
          'vagaTitulo', 'empresaId', 'empresa', 'oficinaId', 'oficina',
          'situacao', 'criadoEm'])
        && dados.keys().hasAll([
          'nome', 'area', 'cargaHoraria', 'vagasTurma', 'descricao', 'vagaId',
          'vagaTitulo', 'empresaId', 'empresa', 'oficinaId', 'oficina',
          'situacao', 'criadoEm'])
        && textoEntre(dados.nome, 1, 80)
        && dados.area is string
        && inteiroEntre(dados.cargaHoraria, 1, 1000)
        && inteiroEntre(dados.vagasTurma, 1, 100)
        && textoEntre(dados.descricao, 0, 500)
        && textoEntre(dados.vagaTitulo, 1, 80)
        && textoEntre(dados.empresa, 1, 120)
        && textoEntre(dados.oficina, 1, 120)
        && dados.criadoEm is timestamp;
    }

    // RF0015: o curso é proposto para uma vaga que existe, da empresa informada.
    function cursoLigadoAVaga() {
      let caminho = /databases/$(database)/documents/vagas/$(request.resource.data.vagaId);
      return exists(caminho)
        && get(caminho).data.empresaId == request.resource.data.empresaId;
    }

    // RN0003: alvará apresentado e dentro da validade (vale até o fim do dia).
    function alvaraEmDia() {
      let oficina = get(/databases/$(database)/documents/oficinas/$(request.auth.uid)).data;
      return 'alvaraValidade' in oficina
        && oficina.alvaraValidade + duration.value(1, 'd') > request.time;
    }

    // A oficina grava os próprios cursos: sem alvará em dia, só como rascunho.
    function oficinaGravaCurso() {
      let dados = request.resource.data;
      return contaConfirmada()
        && exists(/databases/$(database)/documents/oficinas/$(request.auth.uid))
        && dados.oficinaId == request.auth.uid
        && cursoValido()
        && cursoLigadoAVaga()
        && (dados.situacao == 'rascunho'
          || (dados.situacao == 'emAnalise' && alvaraEmDia()));
    }

    // RF0007: só a empresa dona da vaga aprova ou recusa, mudando só a situação.
    function empresaDecideCurso() {
      return contaConfirmada()
        && resource.data.situacao == 'emAnalise'
        && request.resource.data.situacao in ['aprovado', 'recusado']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao'])
        && get(/databases/$(database)/documents/vagas/$(resource.data.vagaId)).data.empresaId
          == request.auth.uid;
    }

    match /cursos/{cursoId} {
      // O curso não guarda dados pessoais; o rascunho só a oficina vê.
      allow read: if resource.data.situacao != 'rascunho'
        || (request.auth != null && resource.data.oficinaId == request.auth.uid);
      allow create: if oficinaGravaCurso();
      allow update: if (resource.data.oficinaId == request.auth.uid
          && resource.data.situacao == 'rascunho'
          && oficinaGravaCurso())
        || empresaDecideCurso();
      allow delete: if request.auth != null && resource.data.oficinaId == request.auth.uid;
    }

    // Qualquer outra coleção fica fechada até ter regra própria.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
